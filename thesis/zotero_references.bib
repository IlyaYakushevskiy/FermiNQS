@misc{fu_minimal_2025,
	title = {A minimal and universal representation of fermionic wavefunctions (fermions = bosons + one)},
	url = {http://arxiv.org/abs/2510.11431},
	doi = {10.48550/arXiv.2510.11431},
	abstract = {Representing fermionic wavefunctions efficiently is a central problem in quantum physics, chemistry and materials science. In this work, we introduce a universal and exact representation of continuous antisymmetric functions by lifting them to continuous symmetric functions defined on an enlarged space. Building on this lifting, we obtain a {\textbackslash}emph\{parity-graded representation\} of fermionic wavefunctions, expressed in terms of symmetric feature variables that encode particle configuration and antisymmetric feature variables that encode exchange statistics. This representation is both exact and minimal: the number of required features scales as \$D{\textbackslash}sim N{\textasciicircum}d\$ (\$d\$ is spatial dimension) or \$D{\textbackslash}sim N\$ depending on the symmetric feature maps employed. Our results provide a rigorous mathematical foundation for efficient representations of fermionic wavefunctions and enable scalable and systematically improvable neural network solvers for many-electron systems.},
	language = {en},
	urldate = {2026-03-05},
	publisher = {arXiv},
	author = {Fu, Liang},
	month = oct,
	year = {2025},
	note = {arXiv:2510.11431 [cond-mat]},
	keywords = {Condensed Matter - Strongly Correlated Electrons, Mathematical Physics, Quantum Physics},
}

