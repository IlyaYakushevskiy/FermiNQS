@article{fiddian-green_mechanisms_1975,
	title = {Mechanisms of disposal of acid and alkali in rabbit duodenum},
	volume = {229},
	issn = {0002-9513},
	doi = {10.1152/ajplegacy.1975.229.6.1641},
	abstract = {Stripped duodenal mucosa of rabbits was mounted in Ussing chambers containing a Ringer solution gassed with 100\% O2. The disappearance of acid or alkali from the mucosal solution of short-circuited tissue was measured with a pH stat while the serosal pH was kept at 7.4. The duodenum rapidly disposed of both acid and alkali; neither property was altered by gassing with N2 while iodoacetate was in the perfusing solutions. Prevention of release of CO2 from the mucosal chamber obliterated the early rapid phase of acid disposal by the mucosa while a similar maneuver in the serosal chamber increased the appearance of serosal acid without altering the rate of acid disposal. Gut sacs of rabbit duodenum in vitro and in vivo showed a positive correlation between acid disposal and the rate of luminal CO2 production. While acid disposal progressively decreased with time for the in vitro gut sacs, the in vivo gut sac showed no fatigue in this respect. Luminal acidification in the Ussing chamber was associated with a profound reduction in short-circuit current (Isc), partially reversible by elevation of the mucosal pH but not by luminal glucose. Our data suggest that acid disposal occurs in part by intraluminal neutralization and in part by diffusion into the mucosa.},
	language = {eng},
	number = {6},
	journal = {The American Journal of Physiology},
	author = {Fiddian-Green, R. G. and Silen, W.},
	month = dec,
	year = {1975},
	keywords = {Acid-Base Equilibrium, Animals, Bicarbonates, Biological Transport, Calcium, Carbon Dioxide, Cations, Divalent, Duodenum, Hydrogen-Ion Concentration, Membrane Potentials, Mucous Membrane, Potassium, Rabbits, Sodium},
	pages = {1641--1648},
}

